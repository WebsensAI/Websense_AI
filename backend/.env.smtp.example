# ---------------------------------------------------------------------
# SMTP configuration sample -- compatible with Gmail App Passwords.
# Copy the four lines below into your real backend/.env file (or merge
# them into your existing .env.example) and fill in your own values.
# ---------------------------------------------------------------------

# Gmail's SMTP endpoint. Leave as-is unless you're using a different
# provider (e.g. smtp.office365.com, smtp.sendgrid.net, your own relay).
SMTP_HOST=smtp.gmail.com

# 587 = STARTTLS (recommended, what this app uses).
# 465 would be implicit TLS/SSL instead -- not what this integration expects.
SMTP_PORT=587

# The full Gmail address you're sending FROM.
SMTP_EMAIL=youraddress@gmail.com

# IMPORTANT: this must be a 16-character Gmail "App Password", NOT your
# normal Gmail account password -- Gmail will reject normal passwords
# for SMTP login (you'll see an auth_failed / "Authentication credentials
# invalid" error) unless you're using an App Password.
#
# How to generate one:
#   1. Turn on 2-Step Verification on your Google account, if it isn't
#      already: https://myaccount.google.com/security
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create a new App Password (name it e.g. "WebSense AI"), Google
#      will show you a 16-character password like: abcd efgh ijkl mnop
#   4. Paste it below with the spaces removed.
SMTP_PASSWORD=your_16_char_app_password
