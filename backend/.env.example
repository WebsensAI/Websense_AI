GROQ_API_KEY=your_groq_api_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=youraddress@gmail.com
SMTP_PASSWORD=your_16_char_app_password
FLASK_SECRET_KEY=any-random-string-you-want

# --- MySQL (users table) ---
# Either set the individual DB_* vars below, or set DATABASE_URL directly
# to override them, e.g.:
# DATABASE_URL=mysql+mysqlconnector://user:password@host:3306/websense_ai
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=websense_ai

# Optional connection pool tuning (sensible defaults if omitted)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
